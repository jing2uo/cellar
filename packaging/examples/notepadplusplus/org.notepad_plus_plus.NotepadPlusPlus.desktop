[Desktop Entry]
Type=Application
Name=Notepad++
GenericName=Text Editor
Comment=Source code editor with syntax highlighting, tabs and plugins
Exec=cellar %F
Icon=org.notepad_plus_plus.NotepadPlusPlus
Terminal=false
StartupNotify=true
StartupWMClass=notepad++.exe
Categories=Utility;TextEditor;
MimeType=text/plain;text/css;text/html;application/javascript;application/json;application/xml;application/x-yaml;text/x-c;text/x-c++src;text/x-python;text/x-sh;text/markdown;
Keywords=notepad;text;editor;scintilla;code;
